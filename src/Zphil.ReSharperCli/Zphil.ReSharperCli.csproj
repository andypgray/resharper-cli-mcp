<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>Major</RollForward>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Global tool + MCP server identity. PackAsTool applies the DotnetTool package type;
             PackageType=McpServer additionally marks it for MCP Registry / NuGet MCP discovery.
             The two coexist. -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>resharper-cli-mcp</ToolCommandName>
        <PackageId>Zphil.ReSharperCli</PackageId>
        <Version>1.5.0</Version>
        <PackageType>McpServer</PackageType>
        <Description>An MCP server for JetBrains' ReSharper command-line tools (InspectCode and CleanupCode). It exposes headless C# inspection and code cleanup to MCP clients over stdio. Unofficial — not affiliated with or endorsed by JetBrains.</Description>
        <Authors>Andrew Gray</Authors>
        <Copyright>Copyright (c) 2026 Andrew Gray</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- The project's own mark, rendered from assets/icon.svg. nuget.org serves the packed icon
             as the page's og:image as well as drawing it in listings, and a social card wants more
             than the 128 px NuGet recommends for the listing itself, so the 512 render is what ships.
             Still no JetBrains brand asset: the mark is original. -->
        <PackageIcon>icon-512.png</PackageIcon>
        <PackageTags>resharper;inspectcode;cleanupcode;code-cleanup;static-analysis;code-quality;mcp;model-context-protocol;csharp;dotnet-tool;claude;cursor;copilot;ai</PackageTags>
        <PackageProjectUrl>https://github.com/andypgray/resharper-cli-mcp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/andypgray/resharper-cli-mcp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- RestoreLockedMode is declared here rather than in Directory.Build.props because Scorecard's
         Pinned-Dependencies check reads csproj files only, and credits it all-or-nothing across them.
         Directory.Build.props holds the full explanation of the lock-file policy. -->
    <PropertyGroup Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

    <ItemGroup>
        <!-- PackagePath must use forward slashes: on the Linux release runner a backslash is not a
             path separator, and 1.0.0 shipped the manifest at `.mcp//server.json`, which broke
             nuget.org's VS Code MCP config detection (it wants exactly `.mcp/server.json`). -->
        <None Include="..\..\README.md" Pack="true" PackagePath="/" />
        <None Include="..\..\.mcp\server.json" Pack="true" PackagePath=".mcp/server.json" />
        <!-- PackageIcon names this file by its packed path, so the two move together. -->
        <None Include="..\..\assets\icon-512.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Zphil.ReSharperCli.Tests" />
        <!-- Lets NSubstitute (Castle DynamicProxy) mock the internal seams (e.g. IProcessRunner). -->
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
        <!-- The handshake icon, read back out as a data: URI for serverInfo.icons. Embedded rather
             than shipped beside the assembly because a data: URI is the one form that does not depend
             on where a tool install, a dnx cache or a container put the file. LogicalName is explicit:
             the file lives outside the project directory, so the derived id would not be predictable. -->
        <EmbeddedResource Include="..\..\assets\icon-128.png" LogicalName="Zphil.ReSharperCli.icon-128.png" />
        <EmbeddedResource Include="server-instructions.md" />
        <EmbeddedResource Include="Prompts\derive-style-guide.md" LogicalName="Zphil.ReSharperCli.Prompts.derive-style-guide.md" />
        <EmbeddedResource Include="Resources\configuration-guide.md" LogicalName="Zphil.ReSharperCli.Resources.configuration-guide.md" />
        <EmbeddedResource Include="Resources\setup-guide.md" LogicalName="Zphil.ReSharperCli.Resources.setup-guide.md" />
    </ItemGroup>

</Project>
