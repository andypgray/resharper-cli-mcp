<!-- The solution the jb contract suite analyses. Deliberately dependency-free: every PackageReference
     would be a restore this fixture cannot make offline, and none of the contracts under test needs one.
     It is never built in the repo tree — the suite copies it to a temp directory first, because cleanup
     rewrites these files in place. -->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>

        <!-- The issues in these files are the fixture's whole point. The compiler must report them without
             stopping the build, or the suite would have nothing to inspect. -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- A dependency-free fixture has no graph to lock, so this property does nothing here except
         satisfy Scorecard's Pinned-Dependencies check, which reads csproj files only and credits
         RestoreLockedMode all-or-nothing across every csproj in the tree — this one included.
         Directory.Build.props holds the full explanation of the lock-file policy.

         It is inert rather than merely unused, which matters because the suite copies this fixture
         to a temp directory and builds it there with an implicit restore, out of reach of
         Directory.Build.props: NuGet reads RestoreLockedMode only inside
         `if (!RestoreForceEvaluate && File.Exists(packagesLockFilePath))`, and lock-file handling
         needs RestorePackagesWithLockFile or an existing lock file to turn on at all. In the temp
         copy neither holds, so locked mode is never consulted and no lock file is written. Do not
         set RestorePackagesWithLockFile=false to reinforce that — NuGet raises NU1005 when it is
         false and a lock file exists, turning a harmless leftover into a hard failure. -->
    <PropertyGroup Condition="'$(CI)' == 'true'">
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

</Project>
