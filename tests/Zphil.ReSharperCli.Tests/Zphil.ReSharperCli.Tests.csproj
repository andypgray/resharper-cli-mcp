<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <!-- RestoreLockedMode is declared here rather than in Directory.Build.props because Scorecard's
         Pinned-Dependencies check reads csproj files only, and credits it all-or-nothing across them.
         Directory.Build.props holds the full explanation of the lock-file policy. -->
    <PropertyGroup Condition="'$(CI)' == 'true'">
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform, not VSTest. xunit.v3 4.0.0 ships MTP 2.x, which the .NET 10 SDK
         refuses to run through the VSTest target at all, so the VSTest-era packages that used to sit
         here — Microsoft.NET.Test.Sdk, xunit.runner.visualstudio, coverlet.collector — have no path
         left to execute on and are gone rather than dormant. Coverage moves with them: coverlet.collector
         is a VSTest data collector, and its replacement below still writes Cobertura, so what changes is
         the flag — the "coverage" option pair MTP supplies, in place of VSTest's "XPlat Code Coverage"
         collector. The runner itself is selected in global.json at the repo root. -->
    <!-- FsCheck.Xunit.v3, not FsCheck.Xunit: the plain package pins
         xunit.extensibility.execution [2.4.1, 3.0.0) — xunit v2 — and cannot restore beside xunit.v3.
         The .v3 variant pins xunit.v3.extensibility.core [4.0.0, 5.0.0), which is this repo's version, and
         still puts [Property] in the FsCheck.Xunit namespace. FsCheck itself is referenced directly rather
         than left transitive so Dependabot tracks the version the property tests are written against. -->
    <ItemGroup>
        <PackageReference Include="FsCheck" Version="3.4.0" />
        <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
        <PackageReference Include="NSubstitute" Version="6.2.0" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Zphil.ReSharperCli\Zphil.ReSharperCli.csproj" />
    </ItemGroup>

    <!-- SARIF/other test fixtures are copied to output, not compiled. An empty Fixtures glob is
         not an error, so this stays safe even when no fixtures are present. -->
    <ItemGroup>
        <Compile Remove="Fixtures/**/*.cs" />
        <Content Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The solution the jb contract suite analyses. It sits outside this project's directory on purpose:
         a csproj nested under another project is swept into that project's **/*.cs compile glob, and these
         files are deliberate compile warnings. Copied as content so the suite can copy it again into a temp
         directory of its own — cleanup rewrites the files it is given, so the tree copy is never the one
         under test. bin/obj are excluded in case someone builds the fixture in place, and so is any
         packages.lock.json: the fixture's CI-gated RestoreLockedMode is inert in temp only because no
         lock file reaches it, so a stray one built in place must not ride along in the copy. -->
    <ItemGroup>
        <Content Include="../Fixtures/ContractSolution/**"
                 Exclude="../Fixtures/ContractSolution/**/bin/**;../Fixtures/ContractSolution/**/obj/**;../Fixtures/ContractSolution/**/packages.lock.json"
                 LinkBase="Fixtures/ContractSolution"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
